#!/usr/bin/env node

/**
 * CLI for exporting markdown to PDF
 * @module @defra/delivery-info-arch-tooling/bin/export-pdf
 */

const fs = require('fs')
const path = require('path')
const { glob } = require('glob')
const { resolveDiagramTags } = require('../lib/pdf/diagrams')
const { resolveStylesheet } = require('../lib/pdf')

// Default patterns
const DEFAULT_PATTERNS = [
  'architecture/**/analysis/**/*.md',
  'architecture/roadmap/**/analysis/**/*.md'
]

// Parse arguments. Flags and files can appear in any order.
const args = process.argv.slice(2)
const styled = args.includes('--styled')
const fileArgs = args.filter(a => !a.startsWith('-'))

async function main () {
  let files

  if (fileArgs.length > 0) {
    files = fileArgs
  } else {
    const allFiles = []
    for (const pattern of DEFAULT_PATTERNS) {
      const matches = await glob(pattern, { cwd: process.cwd() })
      allFiles.push(...matches)
    }
    files = allFiles
  }

  if (files.length === 0) {
    console.log('No markdown files found to export')
    return
  }

  console.log(`Exporting ${files.length} file(s) to PDF...`)

  // Import PDF library
  let mdToPdf
  try {
    const mdToPdfModule = require('md-to-pdf')
    mdToPdf = mdToPdfModule.mdToPdf || mdToPdfModule.default || mdToPdfModule
  } catch (e) {
    console.error('Error: md-to-pdf package is required')
    console.error('Install with: npm install md-to-pdf')
    process.exit(1)
  }

  // Bundled stylesheet (table borders, base typography) only with --styled
  const stylesheet = resolveStylesheet(undefined, styled)

  // Create output directory
  const pdfOutputDir = path.join(process.cwd(), 'generated', 'pdf')
  if (!fs.existsSync(pdfOutputDir)) {
    fs.mkdirSync(pdfOutputDir, { recursive: true })
  }

  for (const file of files) {
    const inputPath = path.resolve(file)

    if (!fs.existsSync(inputPath)) {
      console.error(`❌ File not found: ${file}`)
      continue
    }

    const relativePath = path.relative(process.cwd(), inputPath)
    const outputPath = path.join(pdfOutputDir, relativePath.replace(/\.md$/, '.pdf'))

    const outputDir = path.dirname(outputPath)
    if (!fs.existsSync(outputDir)) {
      fs.mkdirSync(outputDir, { recursive: true })
    }

    try {
      // Configure PDF options
      const pdfOptions = {
        pdf_options: {
          format: 'A4',
          printBackground: true,
          margin: {
            top: '20mm',
            right: '15mm',
            bottom: '20mm',
            left: '15mm'
          }
        },
        stylesheet,
        body_class: 'markdown-body',
        css: 'img { max-width: 100%; height: auto; }',
        basedir: process.cwd(),
        marked_options: {
          breaks: true,
          gfm: true
        }
      }

      // Resolve diagram component tags to images (relative to the markdown file).
      // basedir is the repository root so those relative paths resolve; md-to-pdf
      // keeps the page URL at the markdown's location so other links work too.
      const markdown = fs.readFileSync(inputPath, 'utf8')
      const content = resolveDiagramTags(markdown, { inputPath })

      // Generate PDF
      const pdf = await mdToPdf({ path: inputPath, content }, pdfOptions)

      if (pdf) {
        fs.writeFileSync(outputPath, pdf.content)
        console.log(`✅ ${file} → ${path.relative(process.cwd(), outputPath)}`)
      } else {
        throw new Error('PDF generation returned null')
      }
    } catch (error) {
      console.error(`❌ Failed to export ${file}:`, error.message)
    }
  }

  console.log('\nDone!')
}

main().catch(console.error)
